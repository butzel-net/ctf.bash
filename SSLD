#!/bin/bash
PORT=$1
IP=$(ip -4 route get 0.0.0.1|cut -f 7 -d\  )
CRT=$(mktemp -d)

openssl req -x509 -newkey rsa:4096 -keyout "$CRT/key.pem" -out "$CRT/cert.pem" -days 3665 -nodes -subj "/C=AQ/L=PortLockroy/CN=$IP" &>/dev/null || echo "certificate generation error"

echo -e "connect with openssl\n openssl s_client -connect $IP:$PORT -quiet -no_check_time\n\nstart listener on 0.0.0.0:$PORT" 1>&2

openssl s_server -accept $PORT -key "$CRT/key.pem" -cert "$CRT/cert.pem" -verify 0 -quiet
rm -r $CRT
