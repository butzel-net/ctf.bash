#!/bin/bash
TMUXSES=${1:-"default"}
TMUXLST="$(tmux ls 2>/dev/null | cut -f1 -d: |sort -u)"

if [ $# -eq 0 ]; then
    tmux ls
elif echo "$TMUXLST" | grep -qx "$TMUXSES"; then
    exec tmux a -t "$TMUXSES"
else
    if [ -f "$HOME/.tmux/sessions.py" ]; then
        "$HOME/.tmux/sessions.py" "$TMUXSES" || exit $?
        exec tmux a -t "$TMUXSES"
    else
        exec tmux new -s "$TMUXSES"
    fi
fi
